{% extends "query.jinja2" %}

{% block query_head %}
  <script src="{{ url_for('static', filename='js/d3.min.js') }}"></script>
  <link href="{{ url_for('static', filename='css/detrusty-plan.css') }}" rel="stylesheet" type="text/css" />
  <script src="{{ url_for('static', filename='js/detrusty-plan.js') }}"></script>
{% endblock %}

{% block editor %}
  <div id="yasqe" data-endpoint="{{ url_for('query_plan') }}"></div>
  <div id="plan-error" role="alert"></div>
  <p id="plan-placeholder" class="plan-status">
    Write a query above and press the plan button to see how it is decomposed
    and which endpoint answers each part.
  </p>
  <div id="plan-loading" class="plan-status" role="status" hidden>
    <span class="spinner" aria-hidden="true"></span> Creating plan&hellip;
  </div>
  <div id="plan-container">
    <div id="canvas-wrapper">
      <div id="canvas"></div>
      <div id="canvas-toolbar"></div>
    </div>
    <div id="details"></div>
    <div id="plan-clear"></div>
  </div>
  <div id="plan-tooltip"></div>
{% endblock %}
