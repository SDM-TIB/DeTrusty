<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}{{ title }}{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ url_for('static', filename='favicon.png') }}" />
    <link href="{{ url_for('static', filename='css/detrusty-tokens.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ url_for('static', filename='css/detrusty.css') }}" rel="stylesheet" type="text/css" />
    {% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<nav class="navbar" aria-label="Main">
    <a href="{{ url_for('home') }}" {% if request.endpoint == 'home' %}class="active" aria-current="page"{% endif %}>Home</a>
    <a href="{{ url_for('query_editor') }}" {% if request.endpoint == 'query_editor' %}class="active" aria-current="page"{% endif %}>Query Editor</a>
    <a href="{{ url_for('query_editor_plan') }}" {% if request.endpoint == 'query_editor_plan' %}class="active" aria-current="page"{% endif %}>Query Plan</a>
    <a href="{{ url_for('federation_admin') }}" {% if request.endpoint == 'federation_admin' %}class="active" aria-current="page"{% endif %}>Admin</a>
    <span class="navbar-version">{{ version_string }}</span>
</nav>
<div id="main-content" tabindex="-1">
{% block content %}{% endblock %}
</div>
</body>
</html>
